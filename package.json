{
  "name": "paw-hono-template",
  "version": "1.1.0",
  "private": true,
  "description": "Hono base template with error handler, security headers, E2E tests, and more.",
  "author": "Igor Escalona",
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write",
    "lint": "oxlint",
    "dev": "wrangler dev --env development",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy": "wrangler deploy --env production --minify",
    "prepare": "husky",
    "scaffold": "node scripts/scaffold.mjs",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@commitlint/cli": "^21.2.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "^4.1.10",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "semantic-release": "^25.0.8",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  },
  "engines": {
    "node": ">=24.x",
    "pnpm": ">=11.x"
  },
  "packageManager": "pnpm@11.21.0"
}
