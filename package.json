{
  "name": "paw-hono-template",
  "description": "Hono base template with error handler, security headers, E2E tests, and more.",
  "version": "0.1.0",
  "author": "Igor Escalona",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.x",
    "pnpm": ">=11.x"
  },
  "scripts": {
    "format": "oxfmt --write",
    "lint": "oxlint",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
